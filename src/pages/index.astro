---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
---

<BaseLayout>
  <div class="site-shell">
    <SiteHeader active="home" />
    <main class="home-main">
      <div class="home-intro">
        <section class="home-section" aria-labelledby="about-title">
          <h1 id="about-title">About me</h1>
          <p>Hello! I am Gergely Buza, a postdoc at ETH Zürich under the supervision of <a href="https://georgehaller.com/">George Haller</a>. Previously I was a PhD student (also briefly a postdoc) at the Department of Applied Mathematics and Theoretical Physics at University of Cambridge under the supervision of <a href="https://www.damtp.cam.ac.uk/user/rrk26/">Rich Kerswell</a>.</p>
          <p>I am broadly interested in dynamical systems, both pure and applied. What I have the most experience with is local invariant manifold and foliation theory, specifically in the context of infinite-dimensional systems (e.g., partial differential equations, delay differential equations) and nonautonomous systems.</p>
          <p>You can find my CV <a href="/cv.pdf">here</a>.</p>
        </section>
        <img class="home-photo" src="/profile.jpg" alt="Gergely Buza" />
      </div>
      <section class="home-section home-contact" aria-labelledby="contact-title">
        <h2 id="contact-title">Contact info</h2>
        <p class="contact-email">
          <a href="mailto:buzag@ethz.ch">
            <svg aria-hidden="true" viewBox="0 0 16 16">
              <rect x="1.5" y="3" width="13" height="10" rx="1" />
              <path d="m2 4 6 5 6-5" />
            </svg>
            buzag@ethz.ch
          </a>
        </p>
        <address>
          <strong>ETH Zürich</strong><br />
          Chair in Nonlinear Dynamics<br />
          <a href="https://imes.ethz.ch/utils/location.html?building=LEE&amp;floor=M&amp;room=203">
            LEE M 203
          </a><br />
          Leonhardstrasse 21<br />
          8092 Zürich, Switzerland
        </address>
      </section>
    </main>
  </div>
</BaseLayout>
