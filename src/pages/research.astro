<BaseLayout title="Gergely Buza's webpage" description="Research publications by Gergely Buza.">
  <div class="site-shell">
    <SiteHeader active="research" />
    <main class="page-main">
      <header class="page-heading">
        <h1>Research</h1>
      </header>

      <section class="page-section" aria-labelledby="preprints-title">
        <h2 id="preprints-title">Preprints</h2>
        <div class="publication-list">
          {preprints.map((preprint) => <PublicationCard {...preprint} />)}
        </div>
      </section>

      <section class="page-section" aria-labelledby="publications-title">
        <h2 id="publications-title">Publications</h2>
        <div class="publication-list">
          {publications.map((publication) => <PublicationCard {...publication} />)}
        </div>
      </section>
    </main>
  </div>
</BaseLayout>
