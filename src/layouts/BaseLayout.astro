---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Gergely Buza's webpage",
  description = 'A home for mathematical research, preprints, and teaching.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f5ef" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
